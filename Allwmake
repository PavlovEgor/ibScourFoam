#!/bin/sh
cd "${0%/*}" || exit                            # Run from this directory
. "${WM_PROJECT_DIR:?}"/wmake/scripts/AllwmakeParseArguments
#------------------------------------------------------------------------------
# Install locations are controlled by FOAM_MODULE_PREFIX (or -prefix=...).
# Standalone build: user locations ($FOAM_USER_APPBIN, $FOAM_USER_LIBBIN).
# Built as an OpenFOAM plugin: project locations ($FOAM_APPBIN, $FOAM_LIBBIN).

src/Allwmake $targetType $*
applications/Allwmake $targetType $*

#------------------------------------------------------------------------------
